# Postgres 연결 문자열 (로컬: Docker, 프로덕션: Supabase/Cloud SQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gyca

# Better Auth 세션 암호화 키 — `openssl rand -hex 32` 등으로 생성
BETTER_AUTH_SECRET=

# 앱의 공개 URL (프로덕션: Cloud Run URL 또는 도메인)
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In (Apple Developer Program 필요)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Payments stay disabled by default. Only "tosspayments-test" is supported by the runtime.
# Use a dedicated test database. No live key activation is implemented.
GYCA_PAYMENT_PROVIDER=disabled
TOSS_TEST_MID=
TOSS_TEST_SECRET_KEY=
# Fill only after the EUR API amount unit is confirmed for this merchant: major or minor.
TOSS_EUR_AMOUNT_UNIT=
# Reference to the merchant/currency verification; not a secret or participant consent.
TOSS_EUR_APPROVAL_REFERENCE=

# Internal scheduler endpoint: POST /api/internal/payments/reconcile with JSON {}.
# Dedicated random bearer token (at least 32 characters); never expose to browsers.
PAYMENT_RECOVERY_ENABLED=false
PAYMENT_RECOVERY_TOKEN=

# Scheduler process only: payments, receipts, retention, blind-reviews, or certificates; one invocation handles at most this many jobs.
# GYCA_JOB_KIND=payments
# GYCA_JOB_LIMIT=10

# Private S3 storage: opt-in, bucket versioning and all four public-access blocks required.
GYCA_STORAGE_PROVIDER=disabled
GYCA_S3_REGION=
GYCA_S3_BUCKET=
GYCA_S3_ACCOUNT_ID=
GYCA_S3_ACCESS_KEY_ID=
GYCA_S3_SECRET_ACCESS_KEY=
# Optional temporary-credential token. Omit entirely when using long-lived credentials.
# GYCA_S3_SESSION_TOKEN=

# Separate least-privilege credentials for exact-version retention deletion.
GYCA_S3_RETENTION_ACCESS_KEY_ID=
GYCA_S3_RETENTION_SECRET_ACCESS_KEY=
# GYCA_S3_RETENTION_SESSION_TOKEN=
RETENTION_WORKER_ENABLED=false
RETENTION_JOB_TOKEN=

# Separate least-privilege credentials for blind-review exact reads and create-only derivative writes.
GYCA_S3_BLIND_ACCESS_KEY_ID=
GYCA_S3_BLIND_SECRET_ACCESS_KEY=
# GYCA_S3_BLIND_SESSION_TOKEN=
BLIND_REVIEW_WORKER_ENABLED=false
BLIND_REVIEW_JOB_TOKEN=

# Certificate PDF worker. Keep disabled until the certificate wording/template and private S3 are approved.
CERTIFICATE_WORKER_ENABLED=false
CERTIFICATE_JOB_TOKEN=

# Transactional receipt emails remain disabled until domain and delivery are verified.
GYCA_EMAIL_PROVIDER=disabled
RESEND_API_KEY=
RECEIPT_EMAIL_FROM=
RECEIPT_EMAIL_ENABLED=false
RECEIPT_EMAIL_TOKEN=

# Enable after auth schema migration, verified sender setup and frontend verification flow.
AUTH_EMAIL_VERIFICATION_ENABLED=false

# Enable after reset-password page, auth schema and real email delivery are verified.
AUTH_PASSWORD_RESET_ENABLED=false

# Enable only after guardian page and operating policy review. Email consent is not identity verification.
GYCA_GUARDIAN_CONSENT_ENABLED=false
