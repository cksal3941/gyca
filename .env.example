# Postgres 연결 문자열 (로컬: Docker, 프로덕션: Supabase/Cloud SQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gyca

# Better Auth 세션 암호화 키 — `openssl rand -hex 32` 등으로 생성
BETTER_AUTH_SECRET=

# 앱의 공개 URL (프로덕션: Cloud Run URL 또는 도메인)
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In (Apple Developer Program 필요)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
